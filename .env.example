# Futarchy chess (docs/chess.md, "Operation")
TELARCHY_BASE_URL=https://telarchy.com/api
# Production takes the operator key alone; on the admin-gated beta (https://telarchy.com/beta/api) add a platform-admin session, which only opens the gate
TELARCHY_API_KEY=
TELARCHY_SESSION_EMAIL=
TELARCHY_SESSION_PASSWORD=
TELARCHY_AUTH_URL=https://telarchy.com/api
# A branch preview on the beta, sent as the telarchy_beta_branch cookie
TELARCHY_BRANCH=
TELARCHY_WORKSPACE_ID=
TELARCHY_METRIC_ID=
WORKSPACE_URL=https://telarchy.com/chess
LICHESS_TOKEN=
LICHESS_USERNAME=TelarchyRookie
SEEK=on
PORT=8803
STATE_FILE=state/chess.json
