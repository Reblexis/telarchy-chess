# Futarchy chess (docs/chess.md, "Operation")
TELARCHY_BASE_URL=https://telarchy.com/beta/api
# Production takes the operator key; the admin-gated beta takes a platform-admin session instead
TELARCHY_API_KEY=
TELARCHY_SESSION_EMAIL=
TELARCHY_SESSION_PASSWORD=
TELARCHY_AUTH_URL=https://telarchy.com/api
# A branch preview on the beta, sent as the telarchy_beta_branch cookie
TELARCHY_BRANCH=br-many-option-proposals
TELARCHY_WORKSPACE_ID=
TELARCHY_METRIC_ID=
WORKSPACE_URL=https://telarchy.com/beta/chess
LICHESS_TOKEN=
LICHESS_USERNAME=TelarchyBot
SEEK=on
PORT=8803
STATE_FILE=state/chess.json
