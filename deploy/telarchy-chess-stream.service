# systemd --user unit for the Twitch stream (docs/chess.md, "The stream").
# Needs TWITCH_STREAM_KEY in .env; the channel takes one stream, so stop
# telarchy-snake-stream.service before starting this one.
[Unit]
Description=telarchy-chess: Twitch stream of the game
After=telarchy-chess.service

[Service]
Type=simple
WorkingDirectory=%h/src/telarchy-chess
EnvironmentFile=%h/src/telarchy-chess/.env
ExecStart=/usr/bin/node dist/stream.js
Restart=always
RestartSec=15
StartLimitIntervalSec=0
Nice=10
StandardOutput=append:%h/logs/telarchy-chess-stream.log
StandardError=append:%h/logs/telarchy-chess-stream.log

[Install]
WantedBy=default.target
